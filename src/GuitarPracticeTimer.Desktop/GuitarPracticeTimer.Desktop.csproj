<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GuitarPracticeTimer</AssemblyName>
    <RootNamespace>GuitarPracticeTimer.Desktop</RootNamespace>
    <Product>Guitar Practice Timer</Product>
    <AssemblyTitle>Guitar Practice Timer</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- Icon on the .exe itself, which is what Explorer and a pinned shortcut show. -->
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Size settings, applied only when a runtime identifier is supplied - i.e. on
    `dotnet publish -r <rid>`. Guarding on the RID keeps a plain
    `dotnet build -c Release` (what CI gates on) working, since SelfContained
    without a RID is an error.

    Trimming takes the win-x64 payload from 82 MB to 32 MB; compression takes
    the managed exe itself to under 14 MB.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtraction>true</IncludeNativeLibrariesForSelfExtraction>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    SkiaSharp and HarfBuzz ship native .pdb files worth 100 MB. They are debug
    symbols for someone else's C++ and have no business in a release download.
  -->
  <Target Name="StripNativeSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <!-- The same .ico again, embedded so Window.Icon can set the taskbar icon
         of the running process. The .exe icon alone does not cover that. -->
    <AvaloniaResource Include="..\..\Assets\app.ico" Link="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuitarPracticeTimer.Ui\GuitarPracticeTimer.Ui.csproj" />
  </ItemGroup>
</Project>
