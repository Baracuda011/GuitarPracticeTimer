<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for API 26+. The launcher masks this to whatever shape the
     device uses (circle, squircle, rounded square), so the ring is inset to the
     66dp safe zone of the 108dp canvas and cannot be clipped by the mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/appicon_background" />
  <foreground android:drawable="@drawable/appicon_foreground" />
</adaptive-icon>
