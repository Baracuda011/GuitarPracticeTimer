<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy window background for Android 11 and below, which has no
     SplashScreen API. Flat colour only: SplashView draws the real splash as
     soon as the app has a frame, on 12+ and older alike. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <color android:color="@color/splash_background"/>
  </item>
</layer-list>
