    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuitarPracticeTimer.Core\GuitarPracticeTimer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by make_chime.py; shared with every platform head. -->
    <AvaloniaResource Include="..\..\Assets\chime.wav" Link="Assets/chime.wav" />
  </ItemGroup>

</Project>
