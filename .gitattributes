# Normalise line endings on commit, check out native on Windows.
* text=auto

# Explicitly text
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.md        text
*.py        text diff=python
*.yml       text
*.yaml      text
*.json      text
*.editorconfig text
*.gitattributes text
*.gitignore text

# Scripts keep platform-native endings
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

# Binary — never diff or normalise
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.exe       binary
*.dll       binary
*.pdf       binary
*.zip       binary
*.wav       binary
*.mp3       binary

# Collapse generated/vendored paths in diffs and language stats
publish/*   linguist-generated=true
