<Window x:Class="GuitarPracticeTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guitar Practice Timer"
        Width="360" Height="596"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F7"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8A8F9C"/>
        <SolidColorBrush x:Key="Hairline"    Color="#2A2E3A"/>

        <!-- Primary pill button: filled with the current mode accent -->
        <Style x:Key="PillPrimary" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0E1116"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="23"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.22"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary outline pill -->
        <Style x:Key="PillGhost" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#C9CDD8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="23" Background="#00FFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.25"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title bar glyph button -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7E838F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="#00FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#EDEFF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: 4px track, accent fill, accent thumb -->
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="#1FFFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="#00FFFFFF">
                            <Ellipse x:Name="Halo" Width="20" Height="20"
                                     Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Ellipse Width="14" Height="14"
                                     Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.28"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="#00FFFFFF">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackFill}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackEmpty}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="18" Margin="12"
            Background="{DynamicResource BgBrush}"
            BorderBrush="#26FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Chrome_Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="22,12,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <TextBlock Text="Guitar Practice Timer" FontSize="11.5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Minimise"
                            Click="Minimise_Click"/>
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets" ToolTip="Close"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Dial -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <TextBlock x:Name="ModeLabel" Text="PRACTICE"
                           HorizontalAlignment="Center"
                           FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,4,0,14"/>

                <Grid Width="228" Height="228" HorizontalAlignment="Center">
                    <Ellipse Width="200" Height="200" Stroke="#FFFFFF" Opacity="0.07"
                             StrokeThickness="11"/>
                    <Path x:Name="ProgressArc"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="11"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="3:00"
                                   HorizontalAlignment="Center"
                                   FontSize="64" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimary}"
                                   Typography.NumeralAlignment="Tabular"
                                   Margin="0,0,0,-4"/>
                        <TextBlock x:Name="SubText" Text="ready"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="112"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrimaryButton" Grid.Column="0"
                            Style="{StaticResource PillPrimary}"
                            Content="Start" Click="Primary_Click"/>
                    <Button x:Name="ResetButton" Grid.Column="2"
                            Style="{StaticResource PillGhost}"
                            Content="Reset" Click="Reset_Click"/>
                </Grid>

                <TextBlock x:Name="HintText" Text=""
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <!-- Duration -->
            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Border Height="1" Background="{StaticResource Hairline}"
                        Margin="0,0,0,16"/>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Practice length" FontSize="12"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="DurationLabel" Text="3:00"
                               HorizontalAlignment="Right" FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>
                <Slider x:Name="DurationSlider" Style="{StaticResource FlatSlider}"
                        Minimum="30" Maximum="600" Value="180"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        SmallChange="10" LargeChange="30"
                        ValueChanged="DurationSlider_ValueChanged"/>
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="0:30" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" Opacity="0.75"/>
                    <TextBlock Text="10:00" HorizontalAlignment="Right" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" Opacity="0.75"/>
                </Grid>
            </StackPanel>

        </Grid>
    </Border>
</Window>
